{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-auth-starter-template",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public/"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-auth-starter",
      "database_id": "19be600f-fa75-4a2d-a5a5-a3f4baeb5780",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "better-auth-starter"
    }
  ]
}
